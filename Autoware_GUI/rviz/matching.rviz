Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [ /Global Options1, /PCD Map1, /NDT Pose1 ]
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 37; 43; 53
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Reference Frame: <Fixed Frame>
    - Class: rviz/PointCloud2
      Enabled: true
      Name: PCD Map
      Topic: /points_map
      Queue Size: 10
      Unreliable: false
      Style: Flat Squares
      Size (m): 0.07
      Color Transformer: Intensity
      Channel Name: intensity
      Autocompute Intensity Bounds: true
      Use rainbow: true
      Alpha: 1
    - Class: rviz/PointCloud2
      Enabled: true
      Name: Live Scan
      Topic: /filtered_points
      Queue Size: 5
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 80; 255; 255
      Alpha: 0.65
    - Class: rviz/Pose
      Enabled: true
      Name: NDT Pose
      Topic: /ndt_pose
      Shape: Arrow
      Color: 255; 200; 60
      Alpha: 1
      Shaft Length: 2
      Shaft Radius: 0.15
      Head Length: 0.5
      Head Radius: 0.3
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/SetInitialPose
      Topic: /initialpose
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 65
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.65
      Yaw: 0.7
    Saved: ~
