Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [ /Global Options1, /NDT Map1 ]
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 37; 43; 53
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Reference Frame: <Fixed Frame>
    - Class: rviz/PointCloud2
      Enabled: true
      Name: NDT Map
      Topic: /ndt_map
      Queue Size: 10
      Unreliable: false
      Style: Flat Squares
      Size (m): 0.06
      Color Transformer: Intensity
      Channel Name: intensity
      Autocompute Intensity Bounds: true
      Use rainbow: true
      Alpha: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 65
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.65
      Yaw: 0.7
    Saved: ~
